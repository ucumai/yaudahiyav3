rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function schoolDoc(schoolId) { return /databases/$(database)/documents/schools/$(schoolId); }
    function memberDoc(schoolId, uid) { return /databases/$(database)/documents/schools/$(schoolId)/members/$(uid); }
    function isMember(schoolId) { return signedIn() && exists(memberDoc(schoolId, request.auth.uid)); }
    function myRole(schoolId) { return get(memberDoc(schoolId, request.auth.uid)).data.role; }
    function canWrite(schoolId) { return signedIn() && myRole(schoolId) in ['owner', 'editor']; }
    function isOwner(schoolId) { return signedIn() && myRole(schoolId) == 'owner'; }

    // Default deny
    match /{document=**} { allow read, write: if false; }

    // Uji koneksi (hanya untuk user yang sudah login)
    match /test/{docId} { allow read: if signedIn(); }

    // Daftar sekolah milik pengguna (hanya untuk menu switcher)
    match /users/{uid}/mySchools/{schoolId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid && isValidId(schoolId);
    }

    // Dokumen utama sekolah
    match /schools/{schoolId} {
      allow read: if isMember(schoolId);
      // Buat sekolah baru: pembuat otomatis menjadi ownerUid
      allow create: if signedIn() && isValidId(schoolId)
                    && request.resource.data.ownerUid == request.auth.uid;
      // Klaim sekolah LAMA yang belum punya pemilik (dipakai Tahap 4, lalu aturan ini dihapus)
      allow update: if signedIn() && isValidId(schoolId)
                    && !('ownerUid' in resource.data)
                    && request.resource.data.ownerUid == request.auth.uid;
      // Update normal: editor/owner, ownerUid tidak boleh berubah
      allow update: if canWrite(schoolId)
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwner(schoolId);

      // Anggota sekolah
      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isMember(schoolId));
        // (a) pemilik pertama saat sekolah dibuat / diklaim (dalam batch yang sama)
        allow create: if signedIn() && request.auth.uid == uid
                      && request.resource.data.role == 'owner'
                      && getAfter(schoolDoc(schoolId)).data.ownerUid == request.auth.uid
                      && (!exists(schoolDoc(schoolId)) || !('ownerUid' in get(schoolDoc(schoolId)).data));
        // (b) bergabung lewat kode undangan (Prompt 5, opsional)
        allow create: if signedIn() && request.auth.uid == uid
                      && request.resource.data.role in ['editor', 'viewer']
                      && request.resource.data.inviteCode is string
                      && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.schoolId == schoolId
                      && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.role == request.resource.data.role
                      && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time;
        // owner mengubah peran / mengeluarkan anggota lain; anggota boleh keluar sendiri (kecuali owner)
        allow update: if isOwner(schoolId) && uid != request.auth.uid && request.resource.data.role in ['editor', 'viewer'];
        allow delete: if (isOwner(schoolId) && uid != request.auth.uid)
                      || (request.auth.uid == uid && resource.data.role != 'owner');
      }
    }

    // Kode undangan (opsional, Prompt 5). Get untuk penerima undangan; list hanya untuk pembuat undangan miliknya.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn() && isOwner(request.resource.data.schoolId)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.role in ['editor', 'viewer'];
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Semua koleksi data modul: ID dokumen = schoolId
    match /{col}/{schoolId} {
      allow read: if col in ['teachers_data', 'students_data', 'bku_data', 'logistik_data', 'perbaikan_data', 'eskul_data', 'kombel_data'] && isMember(schoolId);
      allow write: if col in ['teachers_data', 'students_data', 'bku_data', 'logistik_data', 'perbaikan_data', 'eskul_data', 'kombel_data'] && canWrite(schoolId);
    }
  }
}
